{
  "name": "aetherius-os",
  "private": false,
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSING.md",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:apps": "tsc -p apps/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:apps": "node apps/verify.mjs",
    "registry:validate": "vitest run src/programme src/state",
    "build:manifest": "vitest run src/programme/buildManifest.test.ts src/programme/workspaceRegistry.test.ts",
    "build:manifest:report": "vitest run src/programme/buildReport.test.ts src/programme/todoReport.test.ts",
    "capability:report": "vitest run src/programme/capabilityRegistry.test.ts -t regenerates",
    "secret-scan": "python tools/scan_for_secrets.py",
    "release:sbom": "node scripts/release-sbom.mjs",
    "release:notices": "node scripts/generate-third-party-notices.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "verify:pwa": "npm run build && node scripts/verify-pwa.mjs",
    "verify:rollback": "node scripts/verify-rollback.mjs",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "verify": "npm run secret-scan && npm run typecheck && npm run typecheck:apps && npm test && npm run test:apps && npm run build"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@heroicons/react": "^2.2.0",
    "axios": "^1.13.2",
    "lucide-react": "^0.554.0",
    "marked": "^17.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
