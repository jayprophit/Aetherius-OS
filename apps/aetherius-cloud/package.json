{
  "name": "@aetherius/aetherius-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "verify": "node --test tests/*.test.ts",
    "worker:dev": "wrangler dev worker/src/index.ts --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "worker:dry-run": "wrangler deploy --dry-run --outdir .wrangler-dry-run --config worker/wrangler.toml",
    "d1:apply": "wrangler d1 execute aetherius-preview --remote --file d1/0001_sync.sql"
  }
}
