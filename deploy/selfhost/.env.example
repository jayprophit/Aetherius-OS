# Copy this file to .env and replace every CHANGE_ME value.
# Never commit .env or any real secret.

POSTGRES_USER=aetherius
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=aetherius

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME_NEXTCLOUD_ADMIN
NEXTCLOUD_TRUSTED_DOMAINS=localhost
NEXTCLOUD_PROTOCOL=http
NEXTCLOUD_HOST=localhost:8081

COLLABORA_ADMIN_USER=admin
COLLABORA_ADMIN_PASSWORD=CHANGE_ME_COLLABORA_ADMIN
COLLABORA_ALIAS=http://localhost:8081

GIT_HOST=localhost
GIT_ROOT_URL=http://localhost:3001/

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN

SEARXNG_BASE_URL=http://localhost:8088/
SEARXNG_SECRET=CHANGE_ME_RANDOM_64_HEX

# Optional: set when you put the stack behind a TLS reverse proxy.
# AETHERIUS_DOMAIN=cloud.example.com
